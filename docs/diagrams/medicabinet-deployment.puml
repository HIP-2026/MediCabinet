@startuml medicabinet-deployment
' Step 6: adapted to design goals - client-server, external providers behind adapters
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultFontName Helvetica
top to bottom direction

component "Drug Database\nProvider (external)" as ddb
component "Notification Provider\nWeb Push / E-Mail (external)" as push

() "Drug Data\nAPI" as ddbS
() "Notification\nAPI" as pushS

ddb -down- ddbS
push -down- pushS

component "MediCabinet Backend Server" as backend {
  component "Inventory" as inv
  component "Medication\nCatalog" as cat
  component "Interaction\nChecker" as ic
  component "Reminder &\nAlerts" as alerts
}

cat -up-( ddbS
alerts -up-( pushS

() "Inventory\nService" as invS
() "Catalog\nService" as catS
() "Interaction\nService" as icS
() "Reminder\nService" as remS

inv -down- invS
cat -down- catS
ic -down- icS
alerts -down- remS

' internal dependencies inside the backend
ic -( catS
alerts -( invS

component "MediCabinet Webapp" as app {
  component "Scan & Add" as scan
  component "Inventory\nBrowser" as browse
  component "Dose &\nReminder UI" as dose
}

scan -up-( invS
scan -up-( catS
browse -up-( invS
dose -up-( remS
dose -up-( icS
push ..> app : notification
@enduml
